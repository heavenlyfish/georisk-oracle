# GeoRisk Oracle — Environment Variables
# Copy to .env and fill in values

# NVIDIA NIM (required)
NIM_API_KEY=your_nvidia_nim_api_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Risk threshold — alert if score >= this value (0–100)
RISK_THRESHOLD=60

# NewsAPI (optional — enables --scan mode)
NEWS_API_KEY=your_newsapi_key_here

# Llama screener (via NIM — reuses NIM_API_KEY)
LLAMA_MODEL=meta/llama-3.3-70b-instruct

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
