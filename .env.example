# GeoRisk Oracle — Environment Variables
# Copy to .env and fill in values

# ── NVIDIA NIM (required) ─────────────────────────────────────────────────────
NIM_API_KEY=your_nvidia_nim_api_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
LLAMA_MODEL=meta/llama-3.3-70b-instruct

# ── Risk threshold ────────────────────────────────────────────────────────────
RISK_THRESHOLD=60          # send alert if risk_score >= this (0–100)

# ── Watch daemon ──────────────────────────────────────────────────────────────
WATCH_INTERVAL=30          # minutes between scan cycles

# ── NewsAPI (enables live news scanning) ──────────────────────────────────────
NEWS_API_KEY=your_newsapi_key_here

# ── Telegram alerts ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Firebase Firestore (cloud database — required for cloud deployment) ───────
# Paste the ENTIRE contents of your Firebase service account JSON as one line:
# (download from Firebase Console → Project Settings → Service Accounts → Generate new private key)
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
