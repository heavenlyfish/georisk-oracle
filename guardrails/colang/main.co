# GeoRisk Oracle — NeMo Guardrails Colang Policies
# Policy-based guardrails for Nemotron outputs (NemoClaw bonus ⭐)

# ── Input guardrail: only process geopolitical risk topics ──────────────────

define user ask off topic
  "what's the weather today"
  "tell me a joke"
  "write me a poem"
  "help me with my homework"

define bot refuse off topic
  "I can only analyze geopolitical risk events and their supply chain impact. Please provide a news event or geopolitical situation."

define flow check input relevance
  user ask off topic
  bot refuse off topic

# ── Output guardrail: validate risk assessment structure ─────────────────────

define user provides risk assessment
  "risk_score"
  "urgency"
  "causal_chain"
  "hedge_signals"

define bot flag invalid output
  "Output validation failed: risk assessment is missing required fields or contains invalid data. Regenerating."

define flow validate risk output
  user provides risk assessment
  $valid = execute validate_assessment_fields
  if not $valid
    bot flag invalid output

# ── Output guardrail: prevent dangerous financial advice ─────────────────────

define user receives dangerous advice
  "sell everything"
  "go all in"
  "guaranteed profit"
  "risk-free"
  "100% certain"

define bot moderate financial advice
  "Note: All investment signals are for informational purposes only and do not constitute financial advice. Always consult a licensed financial advisor before making investment decisions."

define flow check financial safety
  user receives dangerous advice
  bot moderate financial advice
