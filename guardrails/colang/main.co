# GeoRisk Oracle — NeMo Guardrails Colang Flows (Colang 1.0)
# Policy-based guardrails powered by Nemotron via NIM

# ── Input Rail: Block off-topic requests ─────────────────────────────────────

define user ask off topic
  "what's the weather today"
  "tell me a joke"
  "write me a poem"
  "help me with my homework"
  "what should I have for lunch"
  "who won the game last night"

define bot refuse off topic
  "GeoRisk Oracle only analyzes geopolitical events and their supply chain impact. Please provide a news event or geopolitical situation to analyze."

define flow check geopolitical relevance
  user ask off topic
  bot refuse off topic

# ── Output Rail: Add financial disclaimer when needed ────────────────────────

define user ask for investment advice
  "should I buy"
  "should I sell"
  "is it safe to invest"
  "guaranteed return"
  "risk free"

define bot add financial disclaimer
  "⚠️ Disclaimer: All signals generated by GeoRisk Oracle are for informational purposes only and do not constitute financial advice. Always consult a licensed financial advisor before making investment decisions."

define flow check financial safety disclaimer
  user ask for investment advice
  bot add financial disclaimer
